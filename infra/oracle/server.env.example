NODE_ENV=production
PORT=5000
API_HOST=127.0.0.1
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/tamiltrade_prod
JWT_ACCESS_SECRET=REPLACE_WITH_48_RANDOM_BYTES_AS_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_48_RANDOM_BYTES_AS_HEX
APP_BASE_URL=https://api.example.com
REGISTRATION_ENABLED=false
CORS_ORIGINS=
LOG_LEVEL=info
VOICE_STORAGE_PATH=/var/lib/tamiltrade/audio
VOICE_MAX_DURATION_SECONDS=30
VOICE_MAX_FILE_SIZE_MB=10
VOICE_QUEUE_LIMIT=10
SPEECH_ENGINE=server
# Optional Sarvam cloud recognition: SPEECH_ENGINE=sarvam and a server-only key.
SARVAM_API_KEY=
SARVAM_MODEL=saaras:v4
GROQ_API_KEY=
COMMAND_AI_MODEL=qwen/qwen3.8-27b
COMMAND_AI_TIMEOUT_MS=25000
WHISPER_SERVER_URL=http://127.0.0.1:8080
SPEECH_MODEL_PATH=/opt/tamiltrade/models/ggml-base-q5_1.bin
SPEECH_THREADS=2
SPEECH_BEAM_SIZE=5
SPEECH_TIMEOUT_MS=180000
WHISPER_CLI_PATH=/opt/tamiltrade/whisper.cpp/build/bin/whisper-cli
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
PDF_FONT_PATH=/opt/tamiltrade/current/server/assets/NotoSansTamil-Regular.ttf
PDF_LATIN_FONT_PATH=/opt/tamiltrade/current/server/assets/Inter-Regular.ttf
INVOICE_STORAGE_PATH=/var/lib/tamiltrade/invoices
