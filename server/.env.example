NODE_ENV=development
PORT=5000
# Local phone development: accept API connections over your trusted Wi-Fi.
# Production uses 127.0.0.1 behind the HTTPS proxy.
API_HOST=0.0.0.0
# Separate Atlas development project/database. Production must use mongodb+srv.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/tamiltrade_dev
JWT_ACCESS_SECRET=REPLACE_WITH_AT_LEAST_48_RANDOM_CHARACTERS
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_48_CHARACTER_SECRET
REGISTRATION_ENABLED=true
APP_BASE_URL=https://api.example.com
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:8082,http://127.0.0.1:8082
LOG_LEVEL=info
VOICE_STORAGE_PATH=./data/audio
VOICE_MAX_FILE_SIZE_MB=10
VOICE_MAX_DURATION_SECONDS=30
VOICE_QUEUE_LIMIT=10
SPEECH_MODEL_PATH=/opt/tamiltrade/models/ggml-base-q5_1.bin
SPEECH_ENGINE=server
# For mixed Tamil + English cloud recognition, set SPEECH_ENGINE=sarvam.
# Add the key only on the server; leave blank when using local Whisper.
SARVAM_API_KEY=
SARVAM_MODEL=saaras:v4
# AI understanding for typed commands and transcripts through Groq.
# Add the server-only key from console.groq.com/keys. No fallback is used.
GROQ_API_KEY=
COMMAND_AI_MODEL=qwen/qwen3.8-27b
COMMAND_AI_TIMEOUT_MS=25000
WHISPER_SERVER_URL=http://127.0.0.1:8080
WHISPER_CLI_PATH=/opt/tamiltrade/whisper.cpp/build/bin/whisper-cli
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
SPEECH_THREADS=2
SPEECH_BEAM_SIZE=5
SPEECH_TIMEOUT_MS=180000
PDF_FONT_PATH=./assets/NotoSansTamil-Regular.ttf
PDF_LATIN_FONT_PATH=./assets/Inter-Regular.ttf
INVOICE_STORAGE_PATH=./data/invoices
