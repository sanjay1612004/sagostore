{
  "name": "@tamiltrade/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../scripts/dev-services.mjs",
    "dev:api": "tsx watch --env-file-if-exists=.env src/server.ts",
    "worker": "tsx watch --env-file-if-exists=.env src/workers/voice.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server/src/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/accounting.test.ts tests/command-ai.test.ts tests/voice-rate-limits.test.ts tests/speech.test.ts tests/mobile-api-url.test.ts tests/android-network-policy.test.ts tests/mobile-api-startup.test.ts tests/recording-upload.test.ts tests/haptics.test.ts tests/sarvam.test.ts tests/trade-defaults.test.ts tests/voice-follow-up.test.ts tests/voice-prompts.test.ts tests/dev-services.test.ts tests/worker-database.test.ts tests/phone-security.test.ts tests/phone-session.test.ts tests/stock-display.test.ts",
    "test:integration": "vitest run tests/integration.test.ts tests/phone-auth.integration.test.ts",
    "recover": "tsx --env-file-if-exists=.env scripts/recover.ts",
    "connect:phone": "tsx --env-file-if-exists=.env scripts/connect-phone.ts",
    "test:speech": "vitest run tests/speech.integration.test.ts",
    "test:ai": "vitest run tests/command-ai.integration.test.ts"
  },
  "dependencies": {
    "@tamiltrade/shared": "0.1.0",
    "argon2": "^0.44.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.1",
    "multer": "^2.0.2",
    "pdfkit": "^0.17.2",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.0",
    "@types/pdfkit": "^0.17.3",
    "@types/supertest": "^6.0.3",
    "mongodb-memory-server": "^10.2.3",
    "supertest": "^7.1.4",
    "vitest": "^4.1.12"
  }
}
