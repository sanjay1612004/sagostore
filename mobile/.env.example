# Local development: use the Expo LAN host (native) or browser host (web), port 5000.
# Keep the phone and computer on the same Wi-Fi and run the API with API_HOST=0.0.0.0.
EXPO_PUBLIC_API_URL=auto
EXPO_PUBLIC_WEB_API_URL=auto
# For release builds or Expo tunnels, replace auto with your reachable HTTPS API URL.
